<UserControl x:Class="Scrawl.Controls.NotePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             PreviewMouseDown="Pane_PreviewMouseDown">
    <Border Background="{DynamicResource Bg}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="ActiveBar" Height="2" VerticalAlignment="Top" Background="{DynamicResource Accent}" Visibility="Collapsed" Panel.ZIndex="1"/>
            <DockPanel Margin="26,12,10,8">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Click="Close_Click" ToolTip="Close pane (Ctrl+W)" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11"/>
                </Button>
                <TextBox x:Name="TitleBox" FontSize="24" FontWeight="SemiBold" MaxLength="120" TextChanged="TitleBox_TextChanged" KeyDown="TitleBox_KeyDown" GotKeyboardFocus="Focused"/>
            </DockPanel>
            <Grid x:Name="EditorHost" Grid.Row="1">
                <ae:TextEditor x:Name="Editor" Margin="16,0,0,0" Background="Transparent" Foreground="{DynamicResource Text}" LineNumbersForeground="{DynamicResource Muted}"
                               FontFamily="Cascadia Code, Consolas" FontSize="14" VerticalScrollBarVisibility="Auto" Padding="0,0,16,40"
                               GotKeyboardFocus="Focused" PreviewMouseWheel="Editor_PreviewMouseWheel"/>
            </Grid>

            <!-- Shown instead of the text while a password protected note is locked -->
            <Grid x:Name="LockLayer" Grid.Row="1" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                    <TextBlock Text="This note is locked" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock x:Name="UnlockHint" Text="Enter the password to read it." Foreground="{DynamicResource Muted}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <PasswordBox x:Name="UnlockBox" KeyDown="UnlockBox_KeyDown" PasswordChanged="UnlockBox_PasswordChanged"/>
                    <TextBlock x:Name="UnlockError" Foreground="#E5484D" FontSize="12" Margin="2,6,0,0" Visibility="Collapsed" Text="Wrong password"/>
                    <Button Style="{StaticResource AccentButton}" Content="Unlock" Click="Unlock_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
