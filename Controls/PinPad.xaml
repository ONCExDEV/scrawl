<UserControl x:Class="Scrawl.Controls.PinPad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="Pad_PreviewKeyDown" PreviewMouseDown="Pad_PreviewMouseDown">
    <UserControl.Resources>
        <!-- Round key: soft fill, brighter on hover, accent while pressed -->
        <Style x:Key="PadKey" TargetType="Button">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="62" />
            <Setter Property="Margin" Value="7" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Disc" Fill="{DynamicResource Select}" Opacity="0.55" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Opacity" Value="1" /></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Disc" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Center">
        <StackPanel.RenderTransform><TranslateTransform x:Name="Shake" /></StackPanel.RenderTransform>
        <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18" />
        <UniformGrid Columns="3" Rows="4" HorizontalAlignment="Center">
            <Button Style="{StaticResource PadKey}" Content="1" Tag="1" Click="Key_Click" />
            <Button Style="{StaticResource PadKey}" Content="2" Tag="2" Click="Key_Click" />
            <Button Style="{StaticResource PadKey}" Content="3" Tag="3" Click="Key_Click" />
            <Button Style="{StaticResource PadKey}" Content="4" Tag="4" Click="Key_Click" />
            <Button Style="{StaticResource PadKey}" Content="5" Tag="5" Click="Key_Click" />
            <Button Style="{StaticResource PadKey}" Content="6" Tag="6" Click="Key_Click" />
            <Button Style="{StaticResource PadKey}" Content="7" Tag="7" Click="Key_Click" />
            <Button Style="{StaticResource PadKey}" Content="8" Tag="8" Click="Key_Click" />
            <Button Style="{StaticResource PadKey}" Content="9" Tag="9" Click="Key_Click" />
            <Border Width="62" Height="62" Margin="7" />
            <Button Style="{StaticResource PadKey}" Content="0" Tag="0" Click="Key_Click" />
            <Button x:Name="BackKey" Style="{StaticResource PadKey}" Click="Back_Click" ToolTip="Delete (Backspace)">
                <TextBlock Text="&#xE750;" FontFamily="{StaticResource Icons}" FontSize="18" />
            </Button>
        </UniformGrid>
    </StackPanel>
</UserControl>
