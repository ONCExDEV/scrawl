<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Scrawl</AssemblyName>
    <RootNamespace>Scrawl</RootNamespace>
    <Version>1.0.14</Version>
    <ApplicationIcon>Assets\scrawl.ico</ApplicationIcon>
    <!-- Run on newer .NET too (9, 10, ...) when .NET 8 itself is not installed -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="Scrawl.SmokeTests" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\scrawl.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <!-- Build-time only: generates the few Windows API declarations used to draw color emoji (nothing is added to the exe) -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.*" PrivateAssets="all" />
  </ItemGroup>
</Project>
