<Window x:Class="Scrawl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scrawl" Icon="Assets/scrawl.ico" Height="780" Width="1180" MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource Text}"
        PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <!-- Shadow lives on its own layer so it is not re-rendered while typing -->
        <Border x:Name="ShadowLayer" Margin="10" CornerRadius="16" Background="{DynamicResource Bg}">
            <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
        </Border>
        <Border x:Name="Root" Margin="10" CornerRadius="16" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" SizeChanged="Root_SizeChanged">
            <Grid>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <!-- Top bar: sidebar toggle + menus | tools | theme + window buttons -->
                    <Border Grid.ColumnSpan="2" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"/>
                    <Grid Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Click="ToggleSidebar_Click" ToolTip="Show / hide notes (Ctrl+\)" Margin="0,0,4,0"><TextBlock Text="&#xE700;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                            <Button x:Name="MenuFile" Content="File" Click="Menu_Click" MouseEnter="Menu_MouseEnter" Padding="12,5" Foreground="{DynamicResource Text}"/>
                            <Button x:Name="MenuEdit" Content="Edit" Click="Menu_Click" MouseEnter="Menu_MouseEnter" Padding="12,5" Foreground="{DynamicResource Text}"/>
                            <Button x:Name="MenuView" Content="View" Click="Menu_Click" MouseEnter="Menu_MouseEnter" Padding="12,5" Foreground="{DynamicResource Text}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Click="Undo_Click" ToolTip="Undo (Ctrl+Z)"><TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                            <Button Click="Redo_Click" ToolTip="Redo (Ctrl+Y)"><TextBlock Text="&#xE7A6;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                            <Border Width="1" Height="16" Background="{DynamicResource Line}" Margin="6,0"/>
                            <Button Click="Cut_Click" ToolTip="Cut (Ctrl+X)"><TextBlock Text="&#xE8C6;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                            <Button Click="CopySel_Click" ToolTip="Copy (Ctrl+C)"><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                            <Button Click="Paste_Click" ToolTip="Paste (Ctrl+V)"><TextBlock Text="&#xE77F;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                            <Border Width="1" Height="16" Background="{DynamicResource Line}" Margin="6,0"/>
                            <Button Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)"><TextBlock Text="&#xE71F;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                            <Button Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)"><TextBlock Text="&#xE8A3;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                            <Border Width="1" Height="16" Background="{DynamicResource Line}" Margin="6,0"/>
                            <Button Click="Find_Click" ToolTip="Search notes (Ctrl+F)"><TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Click="Settings_Click" ToolTip="Settings (Ctrl+,)"><TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="15"/></Button>
                            <Button x:Name="ThemeButton" Click="Theme_Click" ToolTip="Theme" Margin="0,0,16,0"><TextBlock Text="&#xE790;" FontFamily="{StaticResource Icons}" FontSize="15"/></Button>
                            <Button Style="{StaticResource Traffic}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"><Button.Tag><SolidColorBrush Color="#FEBC2E"/></Button.Tag></Button>
                            <Button Style="{StaticResource Traffic}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"><Button.Tag><SolidColorBrush Color="#28C840"/></Button.Tag></Button>
                            <Button Style="{StaticResource Traffic}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"><Button.Tag><SolidColorBrush Color="#FF5F57"/></Button.Tag></Button>
                        </StackPanel>
                    </Grid>

                    <!-- Sidebar: the host's width is animated, the content keeps its size and slides out -->
                    <Grid x:Name="SidebarHost" Grid.Row="1" Width="273" ClipToBounds="True">
                        <Grid Width="273" HorizontalAlignment="Left" Background="{DynamicResource Side}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel Margin="16,12,14,8">
                                <Button DockPanel.Dock="Right" Click="NewNote_Click" ToolTip="New note (Ctrl+N)" Foreground="{DynamicResource Text}">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="14"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,9,0"/>
                                    <TextBlock Text="Scrawl" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="12,0,16,10" Height="32">
                                <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16"/>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBox x:Name="SearchBox" Margin="32,0,10,0" VerticalContentAlignment="Center" FontSize="12.5" TextChanged="SearchBox_TextChanged"/>
                                <TextBlock x:Name="SearchHint" Text="Search" IsHitTestVisible="False" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="33,0,0,0"/>
                            </Grid>
                            <ListBox x:Name="NotesList" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="8,0,10,0" SelectionChanged="NotesList_SelectionChanged"
                                     PreviewMouseLeftButtonDown="NotesList_PreviewMouseDown" PreviewMouseMove="NotesList_PreviewMouseMove" PreviewMouseRightButtonDown="NotesList_RightDown" PreviewMouseRightButtonUp="NotesList_RightClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource Text}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE718;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Accent}" Margin="6,2,0,0"
                                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="6,2,0,0"
                                                           Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE71B;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="6,2,0,0" ToolTip="{Binding FilePath}"
                                                           Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,3,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Stamp}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DockPanel Grid.Row="3" Margin="16,8,16,12">
                                <Button DockPanel.Dock="Right" Click="Import_Click" ToolTip="Open files (Ctrl+O)" FontSize="11.5" Padding="10,4">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" FontFamily="{StaticResource Icons}" Margin="0,1,6,0"/><TextBlock Text="Open"/></StackPanel>
                                </Button>
                                <TextBlock x:Name="NotesCount" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                        <Border Width="1" HorizontalAlignment="Right" Background="{DynamicResource Line}"/>
                    </Grid>

                    <!-- Main -->
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid x:Name="EditorLayout" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>

                            <Grid Margin="14,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="ModeText" Style="{StaticResource Seg}" Content="Notepad" Click="Kind_Click" Tag="text" ToolTip="Plain text, nothing else"/>
                                    <RadioButton x:Name="ModeCode" Style="{StaticResource Seg}" Content="Code" Click="Kind_Click" Tag="code" Margin="2,0,0,0" ToolTip="Syntax colors like VS Code"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="PinButton" Click="Pin_Click"><TextBlock x:Name="PinIcon" Text="&#xE718;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                                    <Button Click="Copy_Click" ToolTip="Copy whole note"><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                                    <Button x:Name="ExportButton" Click="Download_Click" MouseEnter="ExportButton_MouseEnter" ToolTipService.IsEnabled="False"><TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                                    <Button Click="Delete_Click" ToolTip="Delete note"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="14"/></Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid x:Name="PaneHost"/>
                                <!-- Drop targets, shown only while a note is being dragged from the list -->
                                <Grid x:Name="DropLayer" Visibility="Collapsed"/>
                            </Grid>

                            <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Side}" CornerRadius="0,0,15,0">
                                <DockPanel Margin="16,0,8,0">
                                    <Button x:Name="LangButton" DockPanel.Dock="Right" Click="Lang_Click" Padding="10,2" FontSize="11.5" ToolTip="Choose language"/>
                                    <TextBlock x:Name="SavedLabel" DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="CursorLabel" DockPanel.Dock="Left" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                    <TextBlock x:Name="WordCount" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                            <TextBlock Text="No note open" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Everything stays on this device." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                            <Button Style="{StaticResource AccentButton}" Click="NewNote_Click" HorizontalAlignment="Center" Content="New note"/>
                            <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,22,0,0" TextAlignment="Center"
                                       Text="Ctrl+N new  ·  Ctrl+O open file  ·  Ctrl+F search"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Shared dropdown for menus, themes, languages, context menus -->
                <Popup x:Name="MenuPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="6" Margin="2,2,14,14" MinWidth="250">
                        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MenuList"/></ScrollViewer>
                    </Border>
                </Popup>


                <!-- Hover flyout of the download button: pick any extension -->
                <Popup x:Name="ExportFlyout" StaysOpen="True" AllowsTransparency="True" PlacementTarget="{Binding ElementName=ExportButton}" Placement="Bottom" HorizontalOffset="-200" PopupAnimation="Fade">
                    <Border x:Name="FlyoutBorder" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="2,2,14,14" Width="264">
                        <StackPanel>
                            <TextBlock Text="Export as" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Export" Click="ExportCustom_Click" Padding="14,7" Margin="8,0,0,0"/>
                                <TextBox x:Name="ExtBox" Text=".txt" FontSize="13.5" Padding="10,6" VerticalContentAlignment="Center" KeyDown="ExtBox_KeyDown" Background="{DynamicResource Bg}" ToolTip="Type any extension, for example .py or .log"/>
                            </DockPanel>
                            <TextBlock Text="Saved straight to your Downloads folder." Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="2,8,0,8"/>
                            <Button Content="Choose location…" Click="ExportChoose_Click" HorizontalContentAlignment="Left" Padding="10,6" Foreground="{DynamicResource Text}"/>
                        </StackPanel>
                    </Border>
                </Popup>


                <!-- Overlays start below the top bar, so the window buttons always work -->
                <!-- Settings -->
                <Grid x:Name="SettingsLayer" Visibility="Collapsed" Margin="0,40,0,0">
                    <Border Background="#99000000" MouseDown="SettingsScrim_MouseDown"/>
                    <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Width="540" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="28,20,16,8">
                                <Button DockPanel.Dock="Right" Click="SettingsClose_Click" ToolTip="Close (Esc)"><TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="12"/></Button>
                                <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="28,4,28,24">
                                    <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,8,0,4"/>
                                    <DockPanel Margin="0,7">
                                        <Button x:Name="ThemeChoice" DockPanel.Dock="Right" Click="ThemeChoice_Click" Padding="14,6" Background="{DynamicResource Select}" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="Theme" FontSize="14" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,7">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Click="FontSmaller_Click" Padding="12,5" Background="{DynamicResource Select}" Foreground="{DynamicResource Text}" Content="–"/>
                                            <TextBlock x:Name="FontSizeText" Width="40" TextAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                            <Button Click="FontBigger_Click" Padding="12,5" Background="{DynamicResource Select}" Foreground="{DynamicResource Text}" Content="+"/>
                                        </StackPanel>
                                        <TextBlock Text="Font size" FontSize="14" VerticalAlignment="Center"/>
                                    </DockPanel>
                                <DockPanel Margin="0,7">
                                    <CheckBox x:Name="SetSans" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Setting_Click" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Proportional font in Notepad" FontSize="14"/></StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,7">
                                    <CheckBox x:Name="SetWrap" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Setting_Click" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Word wrap" FontSize="14"/></StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,7">
                                    <CheckBox x:Name="SetNumbersText" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Setting_Click" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Line numbers in Notepad" FontSize="14"/></StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,7">
                                    <CheckBox x:Name="SetNumbersCode" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Setting_Click" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Line numbers in Code" FontSize="14"/></StackPanel>
                                </DockPanel>

                                    <TextBlock Text="NOTES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,18,0,4"/>
                                    <DockPanel Margin="0,7">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <RadioButton x:Name="NewKindText" Style="{StaticResource Seg}" Content="Notepad" Click="NewKind_Click" Tag="text" Background="{DynamicResource Select}"/>
                                            <RadioButton x:Name="NewKindCode" Style="{StaticResource Seg}" Content="Code" Click="NewKind_Click" Tag="code" Margin="2,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="New notes start as" FontSize="14" VerticalAlignment="Center"/>
                                    </DockPanel>
                                <DockPanel Margin="0,7">
                                    <CheckBox x:Name="SetList" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Setting_Click" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Show the notes list" FontSize="14"/></StackPanel>
                                </DockPanel>

                                    <TextBlock Text="WINDOWS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,18,0,4"/>
                                    <DockPanel Margin="0,7">
                                        <Button DockPanel.Dock="Right" Click="Shortcut_Click" Padding="14,6" Background="{DynamicResource Select}" Foreground="{DynamicResource Text}" Content="Create"/>
                                        <TextBlock Text="Desktop shortcut" FontSize="14" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,7">
                                        <Button DockPanel.Dock="Right" Click="DefaultApp_Click" Padding="14,6" Background="{DynamicResource Select}" Foreground="{DynamicResource Text}" Content="Set up…" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="Open text files with Scrawl" FontSize="14"/>
                                            <TextBlock Text="Makes Scrawl the app for .txt files instead of Notepad. Windows asks you to confirm." FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,16,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,7">
                                        <Button DockPanel.Dock="Right" Click="WelcomeAgain_Click" Padding="14,6" Background="{DynamicResource Select}" Foreground="{DynamicResource Text}" Content="Show"/>
                                        <TextBlock Text="Welcome screen" FontSize="14" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- First start -->
                <Grid x:Name="WelcomeLayer" Visibility="Collapsed" Margin="0,40,0,0">
                    <Border Background="#B3000000"/>
                    <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="20" Width="470" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,30,32,26">
                        <StackPanel>
                            <Image Source="Assets/logo.png" Width="76" Height="76" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Welcome to Scrawl" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                            <TextBlock Text="A notepad when you want one, a code editor when you need one. Everything stays on this device." Foreground="{DynamicResource Muted}" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" Margin="0,0,0,24"/>
                            <DockPanel Margin="0,8">
                                <CheckBox x:Name="WelcomeShortcut" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Create a desktop shortcut?" FontSize="14.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Open Scrawl straight from your desktop." FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,2,16,0"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,24">
                                <CheckBox x:Name="WelcomeDefault" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Use Scrawl for text files?" FontSize="14.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Open .txt files here instead of Notepad. Windows asks you to confirm." FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,16,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Button Style="{StaticResource AccentButton}" Content="Get started" Click="WelcomeDone_Click" Padding="20,11" FontSize="14.5" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="You can change all of this later in Settings." Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- In-app dialog -->
                <Grid x:Name="DialogLayer" Visibility="Collapsed" Margin="0,40,0,0">
                    <Border Background="#99000000" MouseDown="DialogScrim_MouseDown"/>
                    <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,24,26,20">
                        <StackPanel>
                            <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
                            <TextBlock x:Name="DialogText" Foreground="{DynamicResource Text}" Opacity="0.8" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,20" LineHeight="21" TextOptions.TextFormattingMode="Display"/>
                            <PasswordBox x:Name="DialogPw1" Visibility="Collapsed" Margin="0,0,0,10"/>
                            <PasswordBox x:Name="DialogPw2" Visibility="Collapsed" Margin="0,0,0,10"/>
                            <TextBlock x:Name="DialogError" Foreground="#E5484D" FontSize="13" Visibility="Collapsed" Margin="2,0,0,12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="DialogCancel" Click="DialogCancel_Click" Content="Cancel" Padding="18,9" FontSize="14" Foreground="{DynamicResource Text}" Margin="0,0,8,0"/>
                                <Button x:Name="DialogOk" Click="DialogOk_Click" Style="{StaticResource AccentButton}" Content="OK" Padding="20,9" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
