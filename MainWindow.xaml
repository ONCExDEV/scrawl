<Window x:Class="Morrow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Morrow" Height="820" Width="1380" MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        FontFamily="Segoe UI Variable Text" Foreground="{StaticResource Ink}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="18,20,14,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="1,0,0,28">
                    <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource Accent}" Margin="0,0,10,0"><TextBlock Text="m" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/></Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="morrow" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="A little space for your thoughts" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/></StackPanel>
                </StackPanel>
                <Button Grid.Row="1" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Click="NewNote_Click" Margin="0,0,4,18"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="17" Margin="0,-2,7,0"/><TextBlock Text="New note" FontWeight="SemiBold"/></StackPanel></Button>
                <TextBox x:Name="SearchBox" Grid.Row="2" Height="37" Padding="11,0" VerticalContentAlignment="Center" FontSize="12" Background="#F7F7F8" Margin="0,0,4,12" Text="Search notes…" GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" TextChanged="SearchBox_TextChanged" ToolTip="Search notes (Ctrl+F)"/>
                <ListBox x:Name="NotesList" Grid.Row="3" Background="Transparent" BorderThickness="0" SelectionChanged="NotesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="-7,0,0,0">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2,0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="11,10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F5F4F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="●" Foreground="{StaticResource Accent}" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="↗" Foreground="{StaticResource Accent}" Margin="5,0,0,0" Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}"/></DockPanel><TextBlock Text="{Binding Content}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0"/><TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MMM d · HH:mm}'}" FontSize="10" Foreground="#A1A2AA" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,4,0"><DockPanel><Button DockPanel.Dock="Right" Click="Import_Click" Padding="8,5" FontSize="11" Foreground="{StaticResource Accent}" ToolTip="Import a Markdown file">＋ Import</Button><TextBlock x:Name="NotesCount" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel></Border>
            </Grid>
        </Border>
        <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="1"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                <Grid Margin="24,0,20,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Today" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="·" Foreground="#C5C5CA" Margin="10,0"/><TextBlock x:Name="SavedLabel" Text="All changes saved" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PinButton" Click="Pin_Click" ToolTip="Pin note"><TextBlock x:Name="PinIcon" Text="☆" FontSize="18" Foreground="{StaticResource Muted}"/></Button><Button Click="Export_Click" ToolTip="Export Markdown"><TextBlock Text="↧" FontSize="17" Foreground="{StaticResource Muted}"/></Button><Button Click="Copy_Click" ToolTip="Copy Markdown"><TextBlock Text="▢" FontSize="16" Foreground="{StaticResource Muted}"/></Button><Button Click="Delete_Click" ToolTip="Delete note"><TextBlock Text="⌫" FontSize="16" Foreground="{StaticResource Muted}"/></Button></StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Line}"/>
                <Grid Grid.Row="2" x:Name="EditorLayout" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="32,26,26,22">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBox x:Name="TitleBox" FontSize="29" FontWeight="SemiBold" Foreground="#24232C" TextChanged="TitleBox_TextChanged" Margin="0,0,0,19"/>
                        <TextBox x:Name="ContentBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="14" Foreground="#4C4D55" SelectionBrush="#887CEB" TextChanged="ContentBox_TextChanged"/>
                    </Grid>
                    <Border Grid.Column="1" Background="{StaticResource Line}"/>
                    <Grid Grid.Column="2" Margin="26,25,28,20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,15"><TextBlock Text="PREVIEW" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/><TextBlock Text="Markdown · live" FontSize="10" Foreground="#B0B1B9" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PreviewPanel"/></ScrollViewer>
                    </Grid>
                </Grid>
                <Grid Grid.Row="2" x:Name="EmptyState" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="370">
                        <Border Width="62" Height="62" CornerRadius="20" Background="{StaticResource AccentSoft}" Margin="0,0,0,19"><TextBlock Text="✳" Foreground="{StaticResource Accent}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Make room for a thought." FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Your notes stay on this device. Start with a quick note, a checklist, or a snippet of code." FontSize="13" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="15,10,15,20" LineHeight="21"/>
                        <Button Style="{StaticResource AccentButton}" Click="NewNote_Click" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" Margin="0,-2,6,0"/><TextBlock Text="Create your first note" FontWeight="SemiBold"/></StackPanel></Button>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="3" Background="{StaticResource Line}"/>
                <Grid Grid.Row="4" Margin="23,0,22,0"><TextBlock x:Name="WordCount" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="Markdown supported  ·  Ctrl+N new note  ·  Ctrl+S save" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#A3A4AC"/></Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
